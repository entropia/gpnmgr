#: gpnmgr/accounts/templates/request/account_invite_email.html:1
#, python-format
msgid ""
"accounts.request.invite.html %(name)s %(inviter_name)s %(invite_message)s "
"%(invite_link)s %(invite_link)s %(invite_link)s %(team)s"
msgstr ""
"Hello %(name)s,<br><br>you were invited by %(inviter_name)s to create an "
"account at Entropia SSO, to participate at GPN in Team %(team)s.<br>The "
"following note has been left for you:"
"<br><br><blockquote><p>%(invite_message)s</blockquote><br><br>Please click "
"the following <a href='%(invite_link)s'>link</a> to confirm your account and "
"set your password. You can access <a href='%(invite_link)s'>%(invite_link)s</"
"a> manually with your browser if the link is not working.<br><br>Best<br>The "
"GPN Team-Management"

#: gpnmgr/accounts/templates/request/account_invite_email.txt:1
#, python-format
msgid ""
"accounts.request.invite.plaintext %(name)s %(inviter_name)s "
"%(invite_message)s %(invite_link)s %(team)s"
msgstr ""
"Hello %(name)s,\n"
"\n"
"you were invited by %(inviter_name)s to create an account at Entropia SSO, "
"to participate at GPN in Team %(team)s.\n"
"The following note has been left for you: \n"
"\n"
"%(invite_message)s\n"
"\n"
"Please access %(invite_link)s with your browser, to confirm your account and "
"set your password. \n"
"\n"
"Best\n"
"The GPN Team-Management"

