#: gpnmgr/accounts/templates/request/account_invite_email.html:1
#, python-format
msgid ""
"accounts.request.invite.html %(name)s %(inviter_name)s %(invite_message)s "
"%(invite_link)s %(invite_link)s %(invite_link)s %(team)s"
msgstr ""
"Hallo %(name)s,<br><br>du wurdest von %(inviter_name)s eingeladen einen "
"Account im Entropia SSO anzulegen, um auf der GPN im Team %(team)s "
"mitzuarbeiten.<br>Es wurde der folgende Hinweis für dich hinterlassen:"
"<br><br><blockquote><p>%(invite_message)s</blockquote><br><br>Bitte klicke "
"den folgenden <a href='%(invite_link)s'>Link</a>, um deinen Account zu "
"bestätigen und dein Passwort zu setzen. Falls der Link nicht funktioniert, "
"kannst du auch <a href='%(invite_link)s'>%(invite_link)s</a> manuell in "
"deinem Browser aufrufen.<br><br>Viele Grüße<br>Die GPN-Teamverwaltung"

#: gpnmgr/accounts/templates/request/account_invite_email.txt:1
#, python-format
msgid ""
"accounts.request.invite.plaintext %(name)s %(inviter_name)s "
"%(invite_message)s %(invite_link)s %(team)s"
msgstr ""
"Hallo %(name)s,\n"
"\n"
"du wurdest von %(inviter_name)s eingeladen einen Account im Entropia SSO "
"anzulegen, um auf der GPN im Team %(team)s mitzuarbeiten. \n"
"Es wurde der folgende Hinweis für dich hinterlassen: \n"
"\n"
"%(invite_message)s\n"
"\n"
"Bitte rufe %(invite_link)s in deinem Browser auf, um deinen Account zu "
"bestätigen und dein Passwort zu setzen. \n"
"\n"
" Viele Grüße\n"
"Die GPN-Teamverwaltung"

